<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
  <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/poulpoints_logo" android:contentDescription="Logo Poulpoints" />
  <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="8dp" android:text="Poulpoints" android:textStyle="bold" android:textSize="19sp" android:textColor="@color/widget_text"/>
  <TextView android:id="@+id/widget_add" android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="＋" android:textSize="26sp" android:textColor="@color/widget_accent" android:contentDescription="Nouvelle tâche"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:paddingBottom="2dp"/>
 <ListView android:id="@+id/widget_tasks" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="vertical" android:descendantFocusability="blocksDescendants"/>
</LinearLayout>